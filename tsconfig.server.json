{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist/server",
    "rootDir": "./",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": ["server/**/*", "src/types/**/*", "src/services/**/*"]
}
