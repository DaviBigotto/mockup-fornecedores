# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PLURIX ORGANIZER (MÓDULO DE FORNECEDORES)
# ==============================================================================

# Porta do servidor da aplicação
PORT=3000

# Conexão com o banco de dados Neon PostgreSQL
# Obtenha sua Connection String no console do Neon (https://console.neon.tech)
# Exemplo: postgresql://neondb_owner:npg_xyz123@ep-cool-snowflake-a5abcd.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Modo do banco: Se DATABASE_URL estiver vazia ou com falha de conexão,
# a aplicação utilizará automaticamente o repositório de fallback local em memória/JSON
# pré-populado com os 14 cenários realistas de demonstração.
NODE_ENV=development
